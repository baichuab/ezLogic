# The known-good demo: what `deploy/cloudrun.sh rollback` returns to.
# Written by `deploy/cloudrun.sh mark-baseline <name>`; commit it (and push the git tag).
# See deploy/README.md, "Iterating and rolling back".
BASELINE_NAME=demo-baseline-1
# Cloud Run revision (image + settings + environment variables, all immutable)
BASELINE_REVISION=ezlogic-00002-6tq
# Artifact Registry tag on the revision's image (sha256:e693f8051ddc4f36a77f27395209b674f0838666b0ed266b7325197c7aafe40d)
BASELINE_IMAGE_TAG=demo-baseline-1
# Git tag on the code the image was built from (b7ed391, main after PR #15)
BASELINE_GIT_TAG=demo-baseline-1
# Cloud SQL on-demand backup (description; id 1795236838575)
BASELINE_SQL_BACKUP=demo-baseline-1
