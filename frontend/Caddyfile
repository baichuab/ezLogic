{$DOMAIN} {
	handle /api/* {
		# BACKEND_URL defaults to the docker-compose service; on Render it's the
		# backend's public https URL (free services have no private network).
		reverse_proxy {$BACKEND_URL:backend:8000} {
			header_up Host {upstream_hostport}
			flush_interval -1
			transport http {
				read_timeout 620s
			}
		}
	}
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
