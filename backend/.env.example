# OpenRouter (OpenAI-compatible API) -- https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free
AGENT_MAX_STEPS=20

FRONTEND_URL=http://localhost:5173

# Directory the agent can read/write (relative paths are relative to backend/)
WORKSPACE_DIR=./workspace

# Lean toolchain (installed via elan)
LEAN_PATH=lean
LAKE_PATH=lake
LEAN_TIMEOUT=120
# Optional: pin the Lean version used by lean-interact, e.g. v4.19.0
LEAN_VERSION=
LEAN_INTERACT_CACHE=./.lean_cache

# Postgres connection string for chat/turn storage (see database/README.md).
# Local dev: docker run --name ezlogic-db -e POSTGRES_PASSWORD=postgres -p 5432:5432 -d postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# Guest session cookie (backend/guest_session.py). Set this to a persistent
# random value (e.g. `python -c "import secrets; print(secrets.token_urlsafe(32))"`)
# so guest sessions survive a backend restart; otherwise a new secret is
# generated every time the process starts and all guests are logged out.
GUEST_JWT_SECRET=
# Set to true when serving the frontend over HTTPS.
GUEST_COOKIE_SECURE=false
