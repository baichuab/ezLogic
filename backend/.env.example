# Anthropic (via its OpenAI-compatible endpoint) -- https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1/
ANTHROPIC_MODEL=claude-haiku-5-5
AGENT_MAX_STEPS=20
# Give up early -- with the model's best attempt, clearly marked unverified --
# after this many failed Lean checks in a row, or this many seconds, whichever
# comes first, instead of always using every one of AGENT_MAX_STEPS.
AGENT_MAX_FAILED_CHECKS=4
AGENT_TIMEOUT=300
LLM_TIMEOUT=90
# Explaining agent: runs after the writer and breaks the final Lean into
# step-by-step cards linked to line ranges. Empty = use the writer's model.
ANTHROPIC_EXPLAIN_MODEL=
EXPLAIN_TIMEOUT=60

FRONTEND_URL=http://localhost:5173

# Directory the agent can read/write (relative paths are relative to backend/)
WORKSPACE_DIR=./workspace

# Lean toolchain (installed via elan)
LAKE_PATH=lake
LEAN_TIMEOUT=120
# Optional: pin the Lean version used by lean-interact, e.g. v4.19.0
LEAN_VERSION=
LEAN_INTERACT_CACHE=./.lean_cache
# REPL repository lean-interact builds. The official repo has a tag for every Lean
# release; leave LEAN_REPL_REV empty to use the tag matching workspace/lean-toolchain.
LEAN_REPL_GIT=https://github.com/leanprover-community/repl
LEAN_REPL_REV=
# Safety ceiling for starting the REPL and loading Mathlib into it the first time.
LEAN_STARTUP_TIMEOUT=180
# System-wide memory fraction (0-1) above which lean-interact restarts the Lean
# process. Raise this on a memory-constrained dev machine that's otherwise often
# near this threshold, or snippet checks will keep rebuilding Mathlib instead of
# reusing it. Keep it lower on a shared/production server.
LEAN_MAX_TOTAL_MEMORY=0.9

# Postgres connection string for chat/turn storage (see database/README.md).
# Local dev: docker run --name ezlogic-db -e POSTGRES_PASSWORD=postgres -p 5432:5432 -d postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# Guest session cookie (backend/guest_session.py). Set this to a persistent
# random value (e.g. `python -c "import secrets; print(secrets.token_urlsafe(32))"`)
# so guest sessions survive a backend restart; otherwise a new secret is
# generated every time the process starts and all guests are logged out.
GUEST_JWT_SECRET=
# Set to true when serving the frontend over HTTPS.
GUEST_COOKIE_SECURE=false
# Built frontend to serve from this app (the hosted image sets it; empty locally).
# STATIC_DIR=./static
